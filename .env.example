# Optional defaults. The Settings screen also stores keys on this machine.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SCRAPPEY_API_KEY=
PORT=43141

# Keygen.sh — seller machine only. Do not put KEYGEN_TOKEN in the buyer installer.
KEYGEN_ACCOUNT_ID=
KEYGEN_PRODUCT_ID=
KEYGEN_POLICY_ID=
KEYGEN_TOKEN=

# License store. First matching signup becomes admin if no admin exists yet.
# Seed or promote that inbox with `npm run db:seed-admin` (reads ADMIN_PASSWORD from the environment; do not commit it).
ADMIN_EMAIL=

# Postgres on Railway (or any host). Local `npm run dev` falls back to .data JSON files
# when DATABASE_URL is unset or unreachable.
DATABASE_URL=

# Resend.com — welcome and license-key email. Seller machine only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=PlaceFind
