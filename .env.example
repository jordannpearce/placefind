# DataForSEO API access — https://app.dataforseo.com/api-access
# Leave blank to run GridPins in demo mode with mock Austin coffee rankings.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Signed session cookies. Change this in production.
SESSION_SECRET=gridpin-local-dev-secret-change-me

# Public URL used in email links. Production fallback is https://gridpins.com.
# Local/dev without APP_URL uses http://127.0.0.1:43127 so reset links work here.
APP_URL=http://127.0.0.1:43127

# Postgres — set automatically on Railway. Leave blank locally to use .data/gridpin.json.
DATABASE_URL=

# Resend — https://resend.com
# You can also paste the key in Admin → Emails. Leave blank to keep mail in the local inbox.
RESEND_API_KEY=
RESEND_FROM=GridPins <hello@gridpins.com>

# Paddle Billing (live). API key and webhook secret are server-side only.
# PADDLE_ENVIRONMENT is required (production or sandbox). The app will not default it.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=

# Client-side token (live_ prefix on the live account). Either name works.
# Never put PADDLE_API_KEY in client code.
PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Live catalog price IDs — Starter / Pro / Advanced × month / year.
# MONTHLY/ANNUAL aliases are accepted by fulfillment too. Paste IDs from Paddle.
NEXT_PUBLIC_PADDLE_PRICE_STARTER_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_STARTER_YEAR=
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEAR=
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_YEAR=
NEXT_PUBLIC_PADDLE_PRICE_STARTER_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_STARTER_ANNUAL=
NEXT_PUBLIC_PADDLE_PRICE_AGENCY_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_AGENCY_ANNUAL=
NEXT_PUBLIC_PADDLE_PRICE_ENTERPRISE_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_ENTERPRISE_ANNUAL=
NEXT_PUBLIC_PADDLE_PRODUCT_STARTER=
NEXT_PUBLIC_PADDLE_PRODUCT_AGENCY=
NEXT_PUBLIC_PADDLE_PRODUCT_ENTERPRISE=
# Aliases used by some checkout builds (same live prices)
NEXT_PUBLIC_PADDLE_PRICE_STARTER_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_STARTER_YEAR=
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEAR=
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_YEAR=
