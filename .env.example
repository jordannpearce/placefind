# DataForSEO API access — https://app.dataforseo.com/api-access
# Admin/env keys power hosted Starter live Maps (5 scans/month, extra scans $5).
# Never sent to the Starter client. Pro and Advanced save their own keys on Account.
# Leave blank to run GridPins with sample Austin coffee rankings when an account has access.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Signed session cookies. Change this in production.
SESSION_SECRET=gridpin-local-dev-secret-change-me

# Public URL used in email links. Production fallback is https://gridpins.com.
# Local/dev without APP_URL uses http://127.0.0.1:43127 so reset links work here.
APP_URL=http://127.0.0.1:43127

# Postgres — set automatically on the host. Leave blank locally to use .data/gridpin.json.
DATABASE_URL=

# Transactional email. You can also paste the key in Admin → Emails.
# Leave blank to keep mail in the local inbox.
RESEND_API_KEY=
RESEND_FROM=GridPins <hello@gridpins.com>

# Paddle Billing. API key and webhook secret are server-side only.
# PADDLE_ENVIRONMENT must be set to production or sandbox — there is no default.
# Railway: PADDLE_API_KEY, PADDLE_ENVIRONMENT=production, PADDLE_WEBHOOK_SECRET,
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN, NEXT_PUBLIC_PADDLE_PRICE_*.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=production

# Client token is public (Paddle.js only). Either name works. Never put PADDLE_API_KEY in client code.
PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Live catalog price IDs — Starter / Pro / Advanced × month / year.
# MONTHLY/ANNUAL aliases are accepted by fulfillment too.
NEXT_PUBLIC_PADDLE_PRICE_STARTER_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_STARTER_YEAR=
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEAR=
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_YEAR=
NEXT_PUBLIC_PADDLE_PRICE_STARTER_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_STARTER_ANNUAL=
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_PRO_ANNUAL=
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_ANNUAL=
NEXT_PUBLIC_PADDLE_PRODUCT_STARTER=
NEXT_PUBLIC_PADDLE_PRODUCT_PRO=
NEXT_PUBLIC_PADDLE_PRODUCT_ADVANCED=
NEXT_PUBLIC_PADDLE_PRICE_AGENCY_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_AGENCY_ANNUAL=
NEXT_PUBLIC_PADDLE_PRICE_ENTERPRISE_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_ENTERPRISE_ANNUAL=
NEXT_PUBLIC_PADDLE_PRODUCT_AGENCY=
NEXT_PUBLIC_PADDLE_PRODUCT_ENTERPRISE=

# Optional $5 extra-scan catalog. If empty, GridPins can create the product in Paddle.
PADDLE_EXTRA_SCAN_PRICE_ID=
PADDLE_EXTRA_SCAN_PRODUCT_ID=

# Cloro AI Visibility (https://cloro.dev). Prefer Admin → Cloro. Env is a fallback.
# Never sent to customers. Without a key, prompt scans use sample answers.
CLORO_API_KEY=
PADDLE_AI_VISIBILITY_PRICE_ID=
PADDLE_AI_VISIBILITY_PRODUCT_ID=
