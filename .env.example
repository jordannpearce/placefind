# DataForSEO API access — https://app.dataforseo.com/api-access
# Leave blank to run GridPin in demo mode with mock Austin coffee rankings.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Signed session cookies. Change this in production.
SESSION_SECRET=gridpin-local-dev-secret-change-me

# Public URL used in email links
APP_URL=http://127.0.0.1:43127

# Postgres — set automatically on Railway. Leave blank locally to use .data/gridpin.json.
DATABASE_URL=

# Resend — https://resend.com
# You can also paste the key in Admin → Emails. Leave blank to keep mail in the local inbox.
RESEND_API_KEY=
RESEND_FROM=GridPin <beth.t@example.com>
