# Maps search. Admin can also save these; on Railway set them as service variables.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SCRAPPEY_API_KEY=
PORT=43141

# First matching signup becomes admin if no admin exists yet.
# Seed or promote that inbox with `npm run db:seed-admin` (reads ADMIN_PASSWORD from the environment; do not commit it).
ADMIN_EMAIL=

# Postgres on Railway (or any host). Local `npm run dev` falls back to .data JSON files
# when DATABASE_URL is unset or unreachable.
DATABASE_URL=

# Outbound mail for welcome and password-reset messages.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=PlaceFind
